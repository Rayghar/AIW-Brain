PORT=4100
HOST=0.0.0.0
DATABASE_URL=postgresql://aiw:aiw@localhost:5432/aiw
AIW_DB_POOL_MAX=10
AIW_ALLOW_DEV_AUTH=true
AIW_DEV_TOKEN_SECRET=replace-with-a-long-random-development-secret
AIW_DATA_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
AIW_OTEL_SAMPLE_RATIO=0.2
AIW_EVENT_TRANSPORT=outbox
AIW_RUNTIME_INVENTORY_MAX_BYTES=8388608
AIW_ENABLE_REPOSITORY_WRITES=false
AIW_REPOSITORY_TOKEN=
AIW_EVENT_BROKER_ADAPTER=memory
AIW_EVENT_BROKER_ENDPOINT=
AIW_COLLECTOR_SCHEDULE=0 */6 * * *
# Sprint 7.8 governed repository monitoring and snapshot acquisition
# Production recommendation retrieval remains pinned to an approved AIW knowledge release
AIW_ENABLE_GITHUB_KNOWLEDGE=false
AIW_GITHUB_TOKEN=
AIW_KNOWLEDGE_MODEL=gpt-5.6-sol
AIW_ENABLE_LLM_EXTRACTION=false
AIW_EXTRACTION_MAX_FILES_PER_REFRESH=20
AIW_EXTRACTION_FAIL_FAST=false

# Sprint 7.9 configurable LLM Brain
# Tenant overrides store only route metadata and environment-variable references, never secret values.
AIW_LLM_RUNTIME_CONFIG_PATH=config/llm-runtime-overrides.json
# Provider IDs: openai, xai, gemini, qwen, deepseek, custom-openai, local-openai
AIW_LLM_PROVIDER=openai
AIW_LLM_MODEL=gpt-5.6-sol
AIW_LLM_PROTOCOL=responses
AIW_LLM_ALLOW_FALLBACK=true
AIW_LLM_REQUIRE_STRUCTURED_OUTPUT=true
AIW_LLM_MAX_RETRIES=1
AIW_LLM_CIRCUIT_FAILURES=3
AIW_LLM_CIRCUIT_RESET_SECONDS=120
AIW_LLM_TIMEOUT_MS=120000
# Optional full governed policy JSON. It overrides the simple variables above.
AIW_LLM_CONFIG_JSON=
XAI_API_KEY=
XAI_MODEL=grok-3-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
AIW_LLM_QWEN_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AIW_CUSTOM_LLM_API_KEY=
AIW_CUSTOM_LLM_BASE_URL=
AIW_CUSTOM_LLM_MODEL=
AIW_LOCAL_LLM_API_KEY=
AIW_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
AIW_LOCAL_LLM_MODEL=

# Per-purpose overrides (repeat for ARCHITECTURE_REASONING, RECOMMENDATION_EXPLANATION, ARTIFACT_DRAFTING, EMBEDDING)
AIW_LLM_KNOWLEDGE_EXTRACTION_PROVIDER=openai
AIW_LLM_KNOWLEDGE_EXTRACTION_MODEL=gpt-5.6-sol
AIW_LLM_KNOWLEDGE_EXTRACTION_PROTOCOL=responses
AIW_LLM_KNOWLEDGE_EXTRACTION_API_KEY_ENV=OPENAI_API_KEY

# Immutable source snapshot storage: filesystem or s3
AIW_KNOWLEDGE_OBJECT_STORE=filesystem
AIW_KNOWLEDGE_OBJECT_DIR=.aiw-knowledge-objects
AIW_KNOWLEDGE_S3_BUCKET=aiw-knowledge
AIW_KNOWLEDGE_S3_PREFIX=
AIW_KNOWLEDGE_S3_ENDPOINT=
AIW_KNOWLEDGE_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Approved-knowledge vector retrieval
AIW_ENABLE_VECTOR_INDEXING=false
AIW_VECTOR_EMBEDDING_MODE=deterministic
AIW_EMBEDDING_PROVIDER=openai
AIW_EMBEDDING_MODEL=text-embedding-3-small

# Scheduled refresh worker
AIW_REFRESH_CONNECTORS=GH-FINOS-CALM,GH-MICROSOFT-ARCH-CENTER,GH-ASYNCAPI,GH-APACHE-CAMEL,GH-CONTEXT-MAPPER,GH-ARCHUNIT
AIW_REFRESH_TENANT_ID=tenant-reference
AIW_REFRESH_ACTOR=knowledge-refresh-worker
AIW_REFRESH_FAIL_FAST=false
AIW_GITHUB_MAX_TREE_CALLS=2000

# Ed25519 knowledge-release signing (private key is never stored in project data)
AIW_ENABLE_RELEASE_SIGNING=false
AIW_RELEASE_PRIVATE_KEY_PEM=
AIW_RELEASE_PRIVATE_KEY_PATH=
AIW_RELEASE_SIGNER=Architecture Knowledge Release Authority

# Sprint 8.0 architecture synthesis
# Deterministic synthesis works without an LLM. Enable narrative enrichment per API request only.
AIW_SYNTHESIS_DEFAULT_KNOWLEDGE_RELEASE=AKR-0.8.9
AIW_SYNTHESIS_MAX_ALTERNATIVES=7
AIW_SYNTHESIS_REQUIRE_DIVERSITY=true
AIW_SYNTHESIS_SIMULATION_MODEL=aiw-simulation-1.0

# Sprint 8.7.2 enterprise runtime acceptance
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
AIW_RUNTIME_ACCEPTANCE_MODE=report
AIW_RUNTIME_REQUIRED_CHECKS=ACC-POSTGRES,ACC-OBJECT-STORE,ACC-VECTOR,ACC-OIDC,ACC-OTEL,ACC-SIGNING
AIW_RUNTIME_ACCEPTANCE_OPERATORS=user-owner
AIW_RUNTIME_ACCEPTANCE_TENANT=tenant-reference
AIW_OIDC_ISSUER=
AIW_OIDC_AUDIENCE=aiw-api
AIW_GITHUB_ACCEPTANCE_REPOSITORY=
AIW_FITNESS_TARGET_REPOSITORY=


# rc.10.58 durable production worker and scheduled source refresh
AIW_JOB_QUEUE_ADAPTER=file
AIW_JOB_QUEUE_FILE=.aiw-runtime/jobs.json
AIW_WORKER_HEARTBEAT_FILE=.aiw-runtime/worker-heartbeat.json
AIW_WORKER_BACKOFF_MS=1000
AIW_SCHEDULE_TICK_MS=30000
# JSON array. Example: [{"id":"github-daily","tenantId":"tenant-reference","queue":"knowledge-source-refresh","payload":{"repository":"finos/architecture-as-code","ref":"main","allowedPaths":["."]},"everyMs":86400000}]
AIW_SCHEDULED_JOBS_JSON=[]
AIW_REPOSITORY_PROVIDER=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_FILE=
GITLAB_TOKEN=
GITLAB_TOKEN_FILE=
AZURE_DEVOPS_ORGANIZATION=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_PAT_FILE=
