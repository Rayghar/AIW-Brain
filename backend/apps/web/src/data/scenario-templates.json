    {
      "id": "TPL-DIGITAL-BANKING",
      "name": "Digital banking platform",
      "sector": "Financial services",
      "brief": "Retail banking platform serving mobile and web channels: accounts, transfers, cards, statements. Regulated, audited, and expected to stay available through partner outages.",
      "drivers": {
        "availability": 5,
        "security": 5,
        "faultTolerance": 4,
        "performance": 4,
        "modifiability": 3
      },
      "scenarios": [
        {
          "attributeId": "availability",
          "stimulus": "Core banking partner API degrades during business hours",
          "response": "Customer-facing balance and history remain served",
          "responseMeasure": "99.95% monthly availability; partner outage adds < 2s p99"
        },
        {
          "attributeId": "performance",
          "stimulus": "Payday concurrent login surge",
          "response": "Login and balance views stay responsive",
          "responseMeasure": "p99 < 800ms at 3x average load"
        }
      ],
      "seedNodes": [
        {
          "kind": "Actor",
          "label": "Retail Customer"
        },
        {
          "kind": "LogicalService",
          "label": "Channel Gateway",
          "description": "AuthN/Z, rate limits, session"
        },
        {
          "kind": "LogicalService",
          "label": "Accounts Service"
        },
        {
          "kind": "LogicalService",
          "label": "Payments Orchestrator"
        },
        {
          "kind": "ExternalSystem",
          "label": "Core Banking System"
        },
        {
          "kind": "DataStore",
          "label": "Customer Profile Store"
        }
      ],
      "suggestedPatterns": [
        "PAT-API-GATEWAY",
        "PAT-CIRCUIT-BREAKER",
        "PAT-OUTBOX",
        "PAT-IDEMPOTENT"
      ],
      "risks": [
        "Synchronous coupling to the core exposes every channel to its outages",
        "Dual-write between ledger and notifications loses events",
        "Session token misuse across trust boundaries"
      ],
      "governanceChecklist": [
        "Data residency per jurisdiction recorded",
        "PCI scope boundary drawn on canvas",
        "Waivers time-boxed with owners",
        "ADR per accepted style/pattern"
      ]
    },
