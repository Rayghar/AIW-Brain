# AIW MongoDB Atlas persistence profile
# Copy to .env.local or configure these values in your deployment secret manager.
AIW_DATABASE_PROVIDER=mongodb-atlas
MONGODB_URI=mongodb+srv://<aiw_app_user>:<password>@<cluster-name>.<cluster-id>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=aiw
AIW_DB_POOL_MAX=10
AIW_MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000
AIW_ALLOW_DEV_AUTH=true
