# AIW rc.10.73.6 — governed GitHub acquisition
# Store the token in an enterprise secret manager. Do not commit a real value.
AIW_ENABLE_GITHUB_KNOWLEDGE=true
AIW_GITHUB_TOKEN=
AIW_GITHUB_API_BASE=https://api.github.com
AIW_GITHUB_API_VERSION=2026-03-10
AIW_GITHUB_FETCH_CONCURRENCY=4
AIW_GITHUB_RESUME=true
AIW_GITHUB_FAIL_FAST=false
# Empty means all 30 approved connectors.
AIW_REFRESH_CONNECTORS=
AIW_GITHUB_SNAPSHOT_ROOT=../knowledge-repository/AKR-0.10.73.6/github-live
AIW_GITHUB_ACQUISITION_SUMMARY=../release-evidence/rc10.73.6/LIVE_GITHUB_ACQUISITION_SUMMARY.json
# Optional LLM extraction runs only after quarantine and remains candidate-only.
AIW_ENABLE_LLM_EXTRACTION=false
AIW_EXTRACTION_BATCH_SIZE=100
