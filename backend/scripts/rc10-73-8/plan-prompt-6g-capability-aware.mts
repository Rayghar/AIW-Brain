  const observation = /\b(is implemented|are implemented|uses|contains|consists of|provides|includes|supports|exposes|stores|runs|deploys|is configured|are configured)\b/i.test(text);
  const format = String(file?.languageOrFormat ?? extname(record.path).slice(1) ?? 'unknown').toLowerCase() || 'unknown';
  const machine = ['json','yaml','yml','xml','toml','properties','tf','hcl','bicep'].includes(format) || ['structured-data-or-contract','infrastructure-code'].includes(file?.contentKind);
