}

function blindReview(features: Prompt6gRoutingFeatures, decision: Prompt6gRoutingDecision) {
  const complex = features.crossFileGroupIds.length > 0 || features.ambiguity || features.risk === 'high' || Object.values(features.semanticSignals).some(Boolean);
  let independentlyPermitted: 'route-a'|'route-c'|'deferred'|'failure' = 'deferred';
  if (features.processingFailure) independentlyPermitted = 'failure';
  else if (features.noEvidence || features.specialistParserRequirement || (features.machineReadableStructural && features.metadataOnly && !complex)) independentlyPermitted = 'route-c';
  else if (!complex && ['official-reference-architecture','architecture-conformance-implementation','reviewed-practitioner-or-implementation-source'].includes(features.sourceAuthorityClass)
    && ((features.hasSourceExampleIndicators && features.hasConditionMarkers && features.hasLimitationMarkers)
      || (features.hasImplementationObservationIndicators && !features.hasNormativeLanguage && !features.hasSourceExampleIndicators))) independentlyPermitted = 'route-a';
  const confirmed = decision.approvedRoute === independentlyPermitted || (decision.approvedRoute === 'deferred' && independentlyPermitted !== 'failure');
  return { semanticUnitId: features.semanticUnitId, independentlyPermitted, assigned: decision.approvedRoute, confirmed, ambiguityDefaultsToDeferred: true, rationale: confirmed ? 'assignment remains within independently derived capability boundary' : 'enabled assignment lacks independent boundary support' };
}

function chooseStratified(records: any[], perKey: number, key: (item:any)=>string, limit = 120) {
  const selected = new Map<string,any>();
  for (const item of [...records].sort((a,b)=>a.semanticUnitId.localeCompare(b.semanticUnitId))) { const bucket = key(item); const current = [...selected.values()].filter((value)=>key(value)===bucket).length; if (current < perKey) selected.set(item.semanticUnitId,item); if (selected.size >= limit) break; }
  return [...selected.values()];
}

