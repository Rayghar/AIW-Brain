  const contradiction = Boolean(record.contradictionEvidenceEstimate) || /\b(contradict|conflict|inconsistent|whereas|on the other hand)\b/i.test(text);
  const security = /\b(security|authentication|authorization|identity|credential|threat|trust boundary|encryption|least privilege|zero trust)\b/i.test(lower);
  const performance = /\b(performance|latency|throughput|capacity|scalability|efficiency|response time|cache)\b/i.test(lower);
  const causalPattern = /\b(pattern|context|trigger|mechanism|consequence|trade-?off|cause|results in|leads to)\b/i.test(lower);
  const architectureGenome = /\b(architecture genome|reference architecture|topology|blueprint|architecture model)\b/i.test(lower);
  const modernisation = /\b(modernisation|modernization|migration|refactor|legacy|strangler|target state|current state)\b/i.test(lower);
  const productDescription = authority === 'educational-or-discovery-source' && /\b(platform|product|solution|catalog|offering|enables customers|helps teams)\b/i.test(lower);
  const complexEpistemic = /\b(may|might|possibly|typically|generally|often|appears|suggests|assume|hypothesis)\b/i.test(lower) && normative;
  const ambiguity = Boolean(file?.ambiguous) || /\b(unclear|ambiguous|unknown|to be determined|tbd)\b/i.test(lower);
  const specialist = /required/i.test(String(record.parserVersion ?? '')) || file?.parserStatus === 'preserved-awaiting-specialist-parser';
