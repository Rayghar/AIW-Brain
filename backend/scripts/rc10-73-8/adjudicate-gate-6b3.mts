  { caseId: 'G6B1-02', expectedDisposition: 'candidate-assets', permittedDispositions: ['candidate-assets'], primaryAssetTypes: ['implementation-observation','procedure-or-runbook-step'], secondaryAssetTypes: ['source-example','security-control'], assetTypeAliases: { 'security-control': ['security-obligation'] }, permittedSourceAtomEpistemicStatuses: ['implementation-observation','source-stated-recommendation','source-example'], expectedSynthesisStatuses: ['source-direct','deterministic-composition'], fieldEpistemicExpectations: [], conditionApplicability: 'required', requiredConditionEvidenceTerms: ['module test files'], limitationApplicability: 'required', requiredLimitationEvidenceTerms: ['sensitive data should not be stored'], expectedNonClaim: false, expectedAbstention: false },
  { caseId: 'G6B1-05', expectedDisposition: 'candidate-assets', permittedDispositions: ['candidate-assets'], primaryAssetTypes: ['contradiction-or-scoped-distinction'], secondaryAssetTypes: ['security-control','source-example'], assetTypeAliases: { 'security-control': ['security-obligation'] }, permittedSourceAtomEpistemicStatuses: ['normative-requirement','implementation-observation','source-example'], expectedSynthesisStatuses: ['deterministic-composition'], fieldEpistemicExpectations: [{ fieldName: 'condition', permittedStatuses: ['normative-requirement','implementation-observation'] },{ fieldName: 'limitation', permittedStatuses: ['implementation-observation'] }], conditionApplicability: 'required', requiredConditionEvidenceTerms: ['referenced by sha','canonical format'], limitationApplicability: 'required', requiredLimitationEvidenceTerms: ['beyond the scope'], expectedNonClaim: false, expectedAbstention: false },
  { caseId: 'G6B1-06', expectedDisposition: 'candidate-assets', permittedDispositions: ['candidate-assets'], primaryAssetTypes: ['security-control'], secondaryAssetTypes: ['implementation-observation','source-reference'], assetTypeAliases: { 'security-control': ['security-obligation'] }, permittedSourceAtomEpistemicStatuses: ['source-stated-recommendation','implementation-observation','source-example','unknown'], expectedSynthesisStatuses: ['source-direct','deterministic-composition'], fieldEpistemicExpectations: [], conditionApplicability: 'required', requiredConditionEvidenceTerms: ['extreme circumstances'], limitationApplicability: 'required', requiredLimitationEvidenceTerms: ['other security measures'], expectedNonClaim: false, expectedAbstention: false },
  { caseId: 'G6B1-07', expectedDisposition: 'candidate-assets', permittedDispositions: ['candidate-assets'], primaryAssetTypes: ['performance-tactic'], secondaryAssetTypes: ['source-reference','source-example'], assetTypeAliases: { 'performance-tactic': ['performance-efficiency-recommendation'] }, permittedSourceAtomEpistemicStatuses: ['source-stated-recommendation','implementation-observation','unknown'], expectedSynthesisStatuses: ['source-direct','deterministic-composition'], fieldEpistemicExpectations: [], conditionApplicability: 'required', requiredConditionEvidenceTerms: ['dynamic load','latency-sensitive'], limitationApplicability: 'not-applicable', requiredLimitationEvidenceTerms: [], expectedNonClaim: false, expectedAbstention: false },
  { caseId: 'G6B1-09', expectedDisposition: 'candidate-assets', permittedDispositions: ['candidate-assets'], primaryAssetTypes: ['pattern-dna'], secondaryAssetTypes: ['implementation-observation','source-reference'], assetTypeAliases: {}, permittedSourceAtomEpistemicStatuses: ['implementation-observation','source-stated-recommendation'], expectedSynthesisStatuses: ['deterministic-composition'], fieldEpistemicExpectations: [{ fieldName: 'context-or-trigger', permittedStatuses: ['implementation-observation','source-stated-recommendation'] },{ fieldName: 'mechanism', permittedStatuses: ['implementation-observation','source-stated-recommendation'] },{ fieldName: 'consequence', permittedStatuses: ['implementation-observation','source-stated-recommendation'] },{ fieldName: 'trade-off-or-limitation', permittedStatuses: ['implementation-observation','source-stated-recommendation'] }], conditionApplicability: 'required', requiredConditionEvidenceTerms: ['event-driven architecture'], limitationApplicability: 'required', requiredLimitationEvidenceTerms: ['challenges'], expectedNonClaim: false, expectedAbstention: false },
  { caseId: 'G6B1-15', expectedDisposition: 'candidate-assets', permittedDispositions: ['candidate-assets'], primaryAssetTypes: ['implementation-observation'], secondaryAssetTypes: ['source-example','procedure-or-runbook-step'], assetTypeAliases: {}, permittedSourceAtomEpistemicStatuses: ['implementation-observation'], expectedSynthesisStatuses: ['source-direct','deterministic-composition'], fieldEpistemicExpectations: [], conditionApplicability: 'required', requiredConditionEvidenceTerms: ['version 1.3'], limitationApplicability: 'required', requiredLimitationEvidenceTerms: ['requires knowing'], expectedNonClaim: false, expectedAbstention: false },
  { caseId: 'G6B1-21', expectedDisposition: 'candidate-assets', permittedDispositions: ['candidate-assets'], primaryAssetTypes: ['implementation-observation'], secondaryAssetTypes: ['source-reference'], assetTypeAliases: {}, permittedSourceAtomEpistemicStatuses: ['implementation-observation','source-stated-recommendation'], expectedSynthesisStatuses: ['source-direct','deterministic-composition'], fieldEpistemicExpectations: [], conditionApplicability: 'not-applicable', requiredConditionEvidenceTerms: [], limitationApplicability: 'optional', requiredLimitationEvidenceTerms: [], expectedNonClaim: false, expectedAbstention: false },
  { caseId: 'G6B1-24', expectedDisposition: 'abstain-insufficient-evidence', permittedDispositions: ['abstain-insufficient-evidence'], primaryAssetTypes: [], secondaryAssetTypes: [], assetTypeAliases: {}, permittedSourceAtomEpistemicStatuses: ['unknown'], expectedSynthesisStatuses: [], fieldEpistemicExpectations: [], conditionApplicability: 'not-applicable', requiredConditionEvidenceTerms: [], limitationApplicability: 'not-applicable', requiredLimitationEvidenceTerms: [], expectedNonClaim: false, expectedAbstention: true },
];

const originalReview: Record<string, { classification: string[]; rationale: string }> = {
  'G6B1-01': { classification: ['confirmed','wrong-epistemic-level'], rationale: 'Source example is primary, but advice and limitation atoms need their own epistemic statuses; the whole asset cannot describe all atoms.' },
  'G6B1-02': { classification: ['too-narrow','wrong-asset-type'], rationale: 'The passage primarily states CARML implementation and test-file guidelines; source-example is at most secondary.' },
  'G6B1-05': { classification: ['wrong-epistemic-level'], rationale: 'Two atoms are normative, while the scoped distinction assembled across them is deterministic synthesis.' },
  'G6B1-06': { classification: ['confirmed','acceptable-alternative'], rationale: 'Security-control and security-obligation are permitted ontology aliases.' },
  'G6B1-07': { classification: ['wrong-asset-type','limitation-applicability-defect'], rationale: 'The section explicitly concerns Performance Efficiency; single-datacenter scope is not evidence that the primary asset is a resilience control.' },
  'G6B1-09': { classification: ['confirmed','wrong-epistemic-level'], rationale: 'Pattern DNA is correct, but its synthesis status differs from its individually sourced fields.' },
