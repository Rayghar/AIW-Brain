    },
    {
      "attributeId": "scalability",
      "weight": 4
    },
    {
      "attributeId": "modifiability",
      "weight": 4
    },
    {
      "attributeId": "simplicity",
      "weight": 3
    },
    {
      "attributeId": "costEfficiency",
      "weight": 3
    }
  ],
  "qualityScenarios": [
    {
      "id": "qs-payment-provider-latency",
      "attributeId": "availability",
      "source": "External payment provider",
      "stimulus": "Provider becomes unavailable or exceeds timeout",
      "environment": "Peak production traffic",
      "artifact": "Payment integration boundary",
      "response": "Isolate the failure and preserve order status for safe retry",
      "responseMeasure": "No confirmed order is lost; checkout degrades within 3 seconds",
      "weight": 5
    }
  ],
