{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiw.example/schemas/sprint7_7-knowledge-mesh.schema.json",
  "title": "AIW Sprint 7.7 Dynamic Architecture Knowledge Mesh",
  "type": "object",
  "required": ["generatedAt", "connectors", "coverage"],
  "properties": {
    "generatedAt": { "type": "string", "format": "date-time" },
    "connectors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/connector" }
    },
    "coverage": { "type": "object" }
  },
  "$defs": {
    "connector": {
      "type": "object",
      "required": ["id", "name", "owner", "repository", "url", "categories", "trustTier", "lifecycleStatus", "ingestionMode", "allowedPaths", "contentUses", "license", "aiwLeverage", "limitations"],
      "properties": {
        "id": { "type": "string", "pattern": "^GH-" },
        "name": { "type": "string", "minLength": 2 },
        "owner": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "url": { "type": "string", "format": "uri" },
        "defaultBranch": { "type": "string" },
        "categories": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "sourceFamilyIds": { "type": "array", "items": { "type": "string" } },
        "trustTier": { "type": "integer", "minimum": 1, "maximum": 4 },
        "authorityRationale": { "type": "string", "minLength": 20 },
        "lifecycleStatus": { "enum": ["approved", "candidate", "discovery-only", "frozen", "deprecated"] },
        "ingestionMode": { "enum": ["content-reviewed", "metadata-only", "adapter-only", "discovery-only"] },
        "allowedPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "deniedPaths": { "type": "array", "items": { "type": "string" } },
        "maxFilesPerRefresh": { "type": "integer", "minimum": 1 },
        "maxFileBytes": { "type": "integer", "minimum": 1 },
        "refreshCadenceDays": { "type": "integer", "minimum": 1 },
        "contentUses": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "license": {
          "type": "object",
          "required": ["reviewStatus", "usePolicy", "note"],
          "properties": {
            "spdx": { "type": "string" },
            "reviewStatus": { "enum": ["verified", "requires-review", "metadata-only"] },
            "usePolicy": { "enum": ["ingest-with-attribution", "derive-claims-only", "adapter-only", "metadata-only"] },
            "note": { "type": "string" }
          },
          "additionalProperties": false
        },
        "aiwLeverage": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
