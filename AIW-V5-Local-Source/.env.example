# Every setting the workbench reads, rendered from settings.js (node scripts/env-example.mjs).
# Server-side values only. In hosted AIW, set the API values in the platform's runtime settings.
# For local use, copy to .env and start with: node --env-file=.env server.js
# A line that starts with # is a setting left at its default; remove the # to set it.

## Sol and the API (local server and hosted runtime settings alike)
# Secret. The Anthropic key Sol uses (the default provider). Server-side only: never in browser code, never
# committed. It is sent only to the Anthropic endpoint.
ANTHROPIC_API_KEY=
# Which provider answers Sol: anthropic or openai. Unset: anthropic when ANTHROPIC_API_KEY is set, otherwise
# openai when OPENAI_API_KEY is set.
# AIW_LLM_PROVIDER=anthropic
# The model Sol asks for. Anthropic: claude-opus-5-5 unless this names another. OpenAI: gpt-4.1-mini unless this
# names another. A key alone connects; set this only to choose a different model.
# AIW_LLM_MODEL=claude-opus-5-5
# Anthropic only: how much the model thinks before it answers: low, medium, high, xhigh or max. More effort takes
# more time and tokens.
# AIW_LLM_EFFORT=medium
# Anthropic only: default lets the provider re-run a request its model declines on the fallback model it
# recommends, within the same call (a beta of the Messages API); off returns the refusal. A refusal that stands is
# recorded as a withheld draft with its reason, and each run names the model that answered.
# AIW_LLM_REFUSAL_FALLBACK=default
# A gateway for the Anthropic Messages API instead of api.anthropic.com (https, or http on loopback only);
# requests go to <base>/v1/messages. The Anthropic key and every Sol request go to this address, so name only a
# gateway you trust; the server says so at start-up.
# AIW_ANTHROPIC_BASE_URL=
# Secret. The OpenAI key, when Sol uses OpenAI (AIW_LLM_PROVIDER=openai, or the only key set). The key alone
# connects; Sol asks for gpt-4.1-mini unless AIW_LLM_MODEL names another model. The semantic source search uses it
# too. Server-side only: never in browser code, never committed.
# OPENAI_API_KEY=
# An OpenAI-compatible gateway instead of api.openai.com (https, or http on loopback only). The OpenAI key and
# every OpenAI request go to this address, so name only a gateway you trust; the server says so at start-up when
# it is not api.openai.com.
# AIW_LLM_BASE_URL=
# Price per million input tokens, for the estimated cost shown with each Sol run (a figure from your own price
# table, not a provider invoice). Unset: no cost estimate.
# AIW_LLM_PRICE_INPUT_PER_MTOK=
# Price per million output tokens for the same estimate.
# AIW_LLM_PRICE_OUTPUT_PER_MTOK=
# Anthropic: price per million prompt tokens read from the prompt cache. Unset: cache reads are priced as input.
# AIW_LLM_PRICE_CACHE_READ_PER_MTOK=
# Anthropic: price per million prompt tokens written to the prompt cache. Unset: cache writes are priced as input.
# AIW_LLM_PRICE_CACHE_WRITE_PER_MTOK=
# The currency the prices are in.
# AIW_LLM_CURRENCY=USD
# Time allowed for each model call (Sol makes two per request: the draft and its check). A 429, a 5xx or a
# connection that failed before any answer is retried once within it.
# AIW_LLM_TIMEOUT_MS=45000
# More providers beside the default one, as JSON keyed by name. Each entry has its kind (anthropic, openai or
# openai-compatible), its address (baseURL, https or http on loopback), its key (apiKeyEnv, the name of the
# variable that holds it, so the key itself stays out of the JSON), the models it serves, its prices and currency,
# and its daily token budget. A provider answers only the modes a route gives it.
# AIW_LLM_PROVIDERS={"backup":{"kind":"openai-compatible","baseURL":"https://gateway.example/v1","apiKeyEnv":"BACKUP_LLM_KEY","models":"model-a,model-b","pricing":{"input":0.4,"output":1.6,"currency":"USD"},"dailyTokens":2000000}}
# A provider named by its variables instead of AIW_LLM_PROVIDERS (AIW_LLM_BACKUP_KIND names the provider backup):
# its kind, anthropic, openai or openai-compatible. A variable wins over the JSON field with the same meaning.
# AIW_LLM_<NAME>_KIND=openai-compatible
# That provider's address: https, or http on this machine's loopback. Every request and its key go there, so name
# only a service you trust.
# AIW_LLM_<NAME>_BASE_URL=
# Secret. That provider's key. Server-side only; a provider's public view says whether its key is configured,
# never what it is.
# AIW_LLM_<NAME>_API_KEY=
# The models that provider serves, comma-separated; the first answers a route that names the provider without a
# model.
# AIW_LLM_<NAME>_MODELS=
# The name the provider view and the receipts show for that provider.
# AIW_LLM_<NAME>_LABEL=
# That provider's prices per million tokens (_PRICE_INPUT_PER_MTOK, _PRICE_OUTPUT_PER_MTOK,
# _PRICE_CACHE_READ_PER_MTOK, _PRICE_CACHE_WRITE_PER_MTOK) and _CURRENCY, for the estimated cost of its runs:
# figures from your own price table, not a provider invoice.
# AIW_LLM_<NAME>_PRICE_*=
# Anthropic providers only: that provider's effort and _REFUSAL_FALLBACK, as AIW_LLM_EFFORT and
# AIW_LLM_REFUSAL_FALLBACK are for the default provider.
# AIW_LLM_<NAME>_EFFORT=
# The tokens a day that provider is given, shown in the provider view. It is not yet enforced per provider: the
# project drafting budget (Operations, AI disclosure and budget) and the hourly request limit bound what Sol
# sends.
# AIW_LLM_<NAME>_DAILY_TOKENS=
# Which provider and model answer one mode (field, journey, reasoning, review, generate or architecture), as
# provider[:model]; _DRAFT and _CHECK route one pass of that mode (AIW_LLM_ROUTE_ARCHITECTURE_CHECK). The most
# specific route wins; unset, the default provider's model answers.
# AIW_LLM_ROUTE_<MODE>=default:model-a
# Which provider and model answer the draft pass of every mode a more specific route does not name.
# AIW_LLM_ROUTE_DRAFT=default:model-a
# Which provider and model answer the check pass of every mode a more specific route does not name. A check by
# another model reads the draft with other eyes.
# AIW_LLM_ROUTE_CHECK=backup:model-b
# Providers and models (provider:model, comma-separated) tried in order when a call fails on a 5xx, a lost
# connection, a timeout or a refusal; never on a 4xx, a refused key or an answer that did not fit. Each run names
# the model that answered.
# AIW_LLM_FALLBACK=backup:model-b
# Source connection profiles (see CONNECTIONS.md): a JSON array of {id, title, kind, owners, url, tokenEnv}.
# AIW_CONNECTIONS_JSON=
# Secret. The token a connection profile names in tokenEnv. The local server passes every AIW_CONNECTION_TOKEN_*
# variable to the API.
# AIW_CONNECTION_TOKEN_<NAME>=
# The knowledge repository service (see KNOWLEDGE-REPOSITORY.md). The server says at start-up when the token is
# sent beyond loopback.
# AIW_KNOWLEDGE_REPOSITORY_URL=http://127.0.0.1:4180
# Secret. The service token repository:init printed.
# AIW_KNOWLEDGE_REPOSITORY_TOKEN=
# Public keys (JSON, key id to Ed25519 public key) that signed repository sync packets must verify against.
# AIW_REPOSITORY_SYNC_KEYS=
# Public keys that signed repository notices (revocations) must verify against; repository:init prints the value.
# AIW_REPOSITORY_NOTICE_KEYS=
# How often a workbench asks the repository service for due notices before reading a project.
# AIW_REPOSITORY_SYNC_INTERVAL_MS=900000

## Local server only
# Secret. Named accounts so that two people can review each other's claims (four eyes) on one machine. A JSON
# object of account ID to secret (at least 16 characters each). Each person signs in at /local/sign-in. Without
# it, everyone is the single local architect, and only accounts in this list can be granted project or
# organisation roles.
# AIW_LOCAL_ACCOUNTS={"architect":"a-long-private-secret","reviewer":"another-long-private-secret"}
# The local accounts (comma-separated, each one of AIW_LOCAL_ACCOUNTS) that programs sign in with, never people.
# An agent or service account drafts as Sol: its changes are applied unreviewed and say so; it never reviews,
# confirms, accepts or approves anything, never writes as a person, and is never one of the four eyes.
# AIW_AGENT_ACCOUNTS=drafter
# Host names (comma-separated) the workbench answers to besides IP addresses and localhost. Any other Host is
# refused, which blocks DNS-rebinding pages.
# AIW_ALLOWED_HOSTS=workbench.lan
# Mark the session cookie Secure because the workbench is only served over HTTPS.
# AIW_COOKIE_SECURE=1
# Set when a TLS-terminating proxy in front of the workbench sets X-Forwarded-Proto; only then does that header
# mark the session cookie Secure. Unset, the header is ignored.
# AIW_TRUST_PROXY=1
# Listening beyond this computer (--host 0.0.0.0) needs AIW_LOCAL_ACCOUNTS. Only on a network you fully trust,
# this lets it listen without accounts.
# AIW_ALLOW_OPEN_NETWORK=1
# The address to listen on (also --host). Loopback by default.
# AIW_HOST=127.0.0.1
# The port to listen on (also --port).
# PORT=4173
# The browser client to serve: the source modules in public/, or dist/client after npm run build (also --client).
# AIW_CLIENT_DIR=public
# The SQLite database file. Its directory is created if needed.
# AIW_LOCAL_DB=.aiw-local/project.sqlite
# The directory for stored objects (baselines, change history, uploads, Sol runs). Default: "baselines" beside the
# database file, so moving AIW_LOCAL_DB moves both. A backup is the database file and this directory together.
# AIW_LOCAL_FILES=.aiw-local/baselines
# How long a client may take to send one complete request (headers are allowed 30 seconds). Slow or stalled
# clients are closed after it.
# AIW_REQUEST_TIMEOUT_MS=120000
# The memory bound for compressed static files kept between requests; the least recently used are dropped beyond
# it.
# AIW_STATIC_CACHE_BYTES=67108864
# Retention: Sol runs and retrieval packets (rows and files) older than this are removed; 0 keeps them for ever.
# AIW_RETENTION_RUNS_DAYS=90
# Retention: operation events (jobs, syncs, AI operations) older than this are removed; 0 keeps them.
# AIW_RETENTION_EVENTS_DAYS=365
# Retention: activity feed rows older than this are removed; 0 keeps them.
# AIW_RETENTION_ACTIVITY_DAYS=365
# Retention: workbook uploads that no dataset of their project references (uploaded, never applied) older than
# this are removed with their files; 0 keeps them. Applied uploads, projects, baselines, the change journal and
# attachments are never swept.
# AIW_RETENTION_UPLOADS_DAYS=30
# Retention: recovery points a storage upgrade kept (the version it replaced) older than this are retired, the
# newest of each project always kept, with the objects only they kept; 0 keeps them all.
# AIW_RETENTION_RECOVERY_POINTS_DAYS=90
# How often the server runs retention after the start-up run; 0 runs it at start-up only. node
# scripts/retention.mjs runs it on demand.
# AIW_RETENTION_INTERVAL_MS=3600000
# How often the local server resumes one queued architecture drafting slice; 0 runs the recovery sweep at start-up
# only. Hosted Workers need a recurring scheduled trigger.
# AIW_DRAFTING_INTERVAL_MS=10000
# Read the service token from this file instead (the service's own token file).
# AIW_KNOWLEDGE_REPOSITORY_TOKEN_FILE=

## Test suites and evaluation scripts only (never needed to run the workbench)
# A Chromium executable for the browser suites, instead of the one npx playwright install chromium placed.
# AIW_BROWSER_EXECUTABLE=
# Architecture model browser suite: write the selected screenshots and diagnostics to its configured capture
# directory.
# AIW_CAPTURE_BROWSER=
# Focused-case and payment-case journey browser suites: write their desktop and phone screenshots to this
# directory (created if needed). Unset: no screenshots.
# AIW_CASE_SCREENSHOTS=
# Model canvas refinement browser suite: write the expanded Layers screenshots (desktop and phone) to this
# existing directory. Unset: no screenshots.
# AIW_CANVAS_SCREENSHOT_DIR=
# Canvas-draft browser suite: write the pictures of its walk to this directory (created if needed). Unset: no
# pictures.
# AIW_SHOTS=
# Screens-at-size browser suite: limit the run to the named sections (for example B). Unset runs every section.
# AIW_SCREENS_SECTIONS=
# An alternative Playwright module path for the browser suites.
# AIW_PLAYWRIGHT_MODULE=
# An alternative DOM module path for the DOM suites (happy-dom by default).
# AIW_DOM_MODULE=
# Where node release-checks.mjs writes its JSON report.
# AIW_REPORT=
# Per-suite timeout for release-checks.mjs.
# AIW_REGRESSION_TIMEOUT_MS=180000
# How many suites release-checks.mjs runs at once.
# AIW_REGRESSION_CONCURRENCY=3
# Where the Sol evaluation scripts write their report.
# AIW_EVALUATION_REPORT=
# Browser suites: the design topic to exercise.
# AIW_TOPIC=
# Browser suites: the chapter to open.
# AIW_CHAPTER=
# Browser suites: the viewport width.
# AIW_WIDTH=
# Intake suites: a workbook to import instead of the fixture.
# AIW_WORKBOOK=
# Payment pilot only (npm run pilot:payment-case, which also needs AIW_WORKBOOK): the path of the pilot's local
# source PDF. The script only reads it and checks its SHA-256; it copies nothing and writes no project.
# AIW_PAYHUB_PDF=
# Browser suites: start from a blank project.
# AIW_BLANK=
# Explorer suites: where to write screenshots.
# AIW_EXPLORER_OUTPUT=
# Design evaluation: where to write its output.
# AIW_DESIGN_OUTPUT=
# Repository packet verification: the packet file to check.
# AIW_PACKET_PATH=
# Brain UI suite: run the companion checks only.
# AIW_COMPANION_ONLY=
# Scale browser suite: how many Chapter 4 objects the fixture builds.
# AIW_SCALE_COUNT=300
# Scale browser suite: the bound for selecting a node on the model.
# AIW_SCALE_SELECT_MS=600
# Scale browser suite: the bound for saving an edit.
# AIW_SCALE_SAVE_MS=1500
# Scale browser suite: the bound for opening the Work tab.
# AIW_SCALE_WORK_MS=1500
# node scripts/build-scale-fixture.mjs: the running workbench to build the fixture on (also --base).
# AIW_BASE=http://127.0.0.1:4173
# The walkthrough scripts (scripts/refinement-walkthrough.mjs, scripts/workspace-restoration-walkthrough.mjs,
# scripts/model-*-gap.mjs) and the deploy header pointer browser suite: the client directory to serve, an
# immutable built snapshot by preference. Unset: dist/client for the scripts, the suite's own default otherwise.
# AIW_QA_CLIENT=dist/client
# scripts/model-dissect-gap.mjs and scripts/model-gap-walkthrough.mjs: the isolated fixture directory that holds
# project.sqlite and stored-objects (required by those scripts).
# AIW_QA_DIR=
# scripts/model-gap-walkthrough.mjs: the id of the existing synthetic project in that fixture (required on the
# first run).
# AIW_QA_PROJECT_ID=
# scripts/refinement-walkthrough.mjs: where it writes its evidence. Unset: test-results/refinement-walkthrough.
# AIW_QA_ROOT=
# scripts/refinement-walkthrough.mjs: an earlier isolated run (its results.json and database) to reopen instead of
# authoring a fresh project. Never run two writing harnesses on the same database.
# AIW_REVISIT_DIR=
# scripts/refinement-walkthrough.mjs: another run's directory whose results.json is folded into the evidence it
# writes.
# AIW_ADDITIONAL_EVIDENCE=
# scripts/refinement-walkthrough.mjs in model-remainder mode: the chapters whose Model surfaces it visits,
# comma-separated. Unset: every chapter.
# AIW_MODEL_CHAPTERS=
# Diagram readability suite: write each drawing it checks as an SVG to this directory (created if needed). Unset:
# no files.
# AIW_DIAGRAM_QA_DIR=
# Inspector toggle browser suite: an authored walkthrough directory holding results.json and project.sqlite (made
# by scripts/refinement-walkthrough.mjs). The suite needs it and says so.
# AIW_WALKTHROUGH_SOURCE_DIR=
# Inspector toggle browser suite: a built client to serve. Unset: dist/client.
# AIW_WALKTHROUGH_CLIENT_DIR=dist/client
# Model frame browser suite: the client directory to serve instead of the suite's default.
# AIW_FRAME_CLIENT=
# Model frame browser suite: write its Chapter 4, 7 and 11 screenshots to this directory (created if needed).
# Unset: no screenshots.
# AIW_MODEL_FRAME_EVIDENCE=
# Model restored-guidance browser suite: where it writes its evidence. Unset:
# test-results/model-restored-guidance.
# AIW_MODEL_GUIDANCE_EVIDENCE=
# Model restored-guidance browser suite: the client directory to serve. Unset: public.
# AIW_MODEL_GUIDANCE_CLIENT=public
# Model tab refinement browser suite: where it writes its evidence. Unset: audit/round27/model.
# AIW_MODEL_REFINEMENT_EVIDENCE=
# Round 27 Work browser suite: the client directory to serve. Unset: public.
# AIW_TEST_CLIENT=public
# Round 27 Work browser suite: run one phase only (actions, or late for the closing checks). Unset: every phase.
# AIW_TEST_PHASE=actions
# Shell restoration browser suite: the client directory to serve. Unset: public.
# AIW_SHELL_RESTORATION_CLIENT=public
# Shell restoration browser suite: the JSON file to write its evidence to (its directory is created). Unset: no
# file.
# AIW_SHELL_RESTORATION_EVIDENCE=
# Specification reading suite: write its rendered fixtures to this directory (created if needed). Unset: no files.
# AIW_SPEC_VISUAL_DIR=
# Work sections suite: write a styled HTML fixture of each Work view to this directory. Unset: no files.
# AIW_WORK_FIXTURE_DIR=
# Workbench UI suite: the client entry module to load. Unset: public/entry.js.
# AIW_CLIENT_ENTRY=
# scripts/workspace-restoration-walkthrough.mjs: where it writes its evidence. Unset: audit/round29/integrated.
# AIW_RESTORATION_EVIDENCE=
# scripts/workspace-restoration-walkthrough.mjs: an extracted fixture directory to restore from instead of the
# committed archive.
# AIW_RESTORATION_FIXTURE=
# scripts/workspace-restoration-walkthrough.mjs: run only the checks whose name contains this text. Unset: every
# check.
# AIW_RESTORATION_CHECK=
