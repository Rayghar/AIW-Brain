%% Neighbourhood bike share · Mermaid C4Container fixture (AIW authored teaching example).
C4Container
  title Neighbourhood bike share · containers

  Person(resident, "Resident", "Signs up, unlocks a bike, rides and pays the fee.")
  Person_Ext(contractor, "Rebalancing contractor", "Moves bikes between docks each morning.")
  System_Ext(payment, "Payment provider", "The council's existing provider holds the tokenised card.")
  System_Ext(dock, "Dock hardware", "Speaks a vendor protocol over mobile data.")

  Container_Boundary(platform, "Bike share platform") {
    Container(app, "Mobile app", "Mobile app", "Shows docks with available bikes and unlocks a bike.")
    Container(dockgateway, "Dock gateway", "Protocol adapter", "Talks to the dock hardware over the vendor protocol.")
    Container(tripservice, "Trip service", "Service", "Records each trip exactly once, from unlock to return.")
    Container(pricing, "Pricing and payment service", "Service", "Calculates the fee and charges the saved payment method.")
    ContainerDb(tripstore, "Trip store", "Relational database", "Keeps trips, members and dock status.")
    ContainerQueue(events, "Trip events", "Message broker", "Carries unlock, return and charge events between services.")
  }

  Rel(resident, app, "Finds a dock, unlocks a bike and sees receipts")
  Rel(contractor, app, "Reads the morning rebalancing list")
  Rel(app, tripservice, "Asks for docks and unlocks a bike", "HTTPS")
  Rel_D(dockgateway, tripservice, "Reports unlock and return events", "Message")
  Rel(tripservice, tripstore, "Reads and writes trips", "SQL")
  Rel(tripservice, events, "Publishes trip completed", "Event")
  Rel(pricing, events, "Subscribes to trip completed", "Event")
  BiRel(pricing, tripstore, "Reads the trip and writes the charge", "SQL")
  Rel(dockgateway, dock, "Releases the lock and reads dock status", "Vendor protocol")
  Rel(pricing, payment, "Charges the fee to the tokenised card", "HTTPS")

  UpdateRelStyle(resident, app, $offsetY="-40")
  UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")
