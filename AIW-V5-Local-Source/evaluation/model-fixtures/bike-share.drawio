<?xml version="1.0" encoding="UTF-8"?>
<!-- Neighbourhood bike share · draw.io fixture (AIW authored teaching example): C4 library cells (object cells with c4Type, c4Name, c4Technology, c4Description), C4 relationships, one ArchiMate 3 shape, one plain cell the reader omits. Uncompressed. -->
<mxfile host="AIW" type="device">
  <diagram id="containers" name="Containers">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <object placeholders="1" c4Name="Resident" c4Type="Person" c4Description="Signs up, unlocks a bike, rides and pays the fee." label="%c4Name%" id="resident">
          <mxCell style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="200" height="180" as="geometry"/></mxCell>
        </object>
        <object placeholders="1" c4Name="Bike share platform" c4Type="SystemScopeBoundary" c4Application="Software System" label="%c4Name%" id="boundary-platform">
          <mxCell style="rounded=1;fontSize=11;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBorderColor=none;spacingTop=0;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;noLabel=0;labelPadding=0;allowArrows=0;connectable=0;expand=0;recursiveResize=0;editable=1;pointerEvents=0;absoluteArcSize=1;points=[];" vertex="1" parent="1"><mxGeometry x="320" y="40" width="760" height="520" as="geometry"/></mxCell>
        </object>
        <object placeholders="1" c4Name="Mobile app" c4Type="Container" c4Technology="Mobile app" c4Description="Shows docks with available bikes and unlocks a bike." label="%c4Name%" id="app">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="boundary-platform"><mxGeometry x="40" y="60" width="240" height="120" as="geometry"/></mxCell>
        </object>
        <object placeholders="1" c4Name="Trip service" c4Type="Container" c4Technology="Service" c4Description="Records each trip exactly once, from unlock to return." label="%c4Name%" id="tripservice">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;" vertex="1" parent="boundary-platform"><mxGeometry x="40" y="240" width="240" height="120" as="geometry"/></mxCell>
        </object>
        <object placeholders="1" c4Name="Pricing and payment service" c4Type="Container" c4Technology="Service" c4Description="Calculates the fee and charges the saved payment method." label="%c4Name%" id="pricing">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;" vertex="1" parent="boundary-platform"><mxGeometry x="400" y="240" width="240" height="120" as="geometry"/></mxCell>
        </object>
        <object placeholders="1" c4Name="Trip store" c4Type="Container" c4Technology="Relational database" c4Description="Keeps trips, members and dock status." label="%c4Name%" id="tripstore">
          <mxCell style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=12;align=center;strokeColor=#0E7DAD;metaEdit=1;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.5,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];resizable=0;" vertex="1" parent="boundary-platform"><mxGeometry x="40" y="400" width="240" height="120" as="geometry"/></mxCell>
        </object>
        <object placeholders="1" c4Name="Payment provider" c4Type="Software System" c4Description="The council's existing provider holds the tokenised card." label="%c4Name%" id="payment">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;resizable=0;" vertex="1" parent="1"><mxGeometry x="1120" y="280" width="240" height="120" as="geometry"/></mxCell>
        </object>
        <object placeholders="1" c4Type="Relationship" c4Technology="HTTPS" c4Description="Asks for docks and unlocks a bike" label="%c4Description%" id="rel-app-trip">
          <mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="app" target="tripservice"><mxGeometry width="240" relative="1" as="geometry"/></mxCell>
        </object>
        <object placeholders="1" c4Type="Relationship" c4Technology="SQL" c4Description="Reads and writes trips" label="%c4Description%" id="rel-trip-store">
          <mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="tripservice" target="tripstore"><mxGeometry width="240" relative="1" as="geometry"/></mxCell>
        </object>
        <object placeholders="1" c4Type="Relationship" c4Technology="Event" c4Description="Publishes trip completed" label="%c4Description%" id="rel-trip-pricing">
          <mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="tripservice" target="pricing"><mxGeometry width="240" relative="1" as="geometry"/></mxCell>
        </object>
        <object placeholders="1" c4Type="Relationship" c4Technology="HTTPS" c4Description="Charges the fee to the tokenised card" label="%c4Description%" id="rel-pricing-payment">
          <mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="pricing" target="payment"><mxGeometry width="240" relative="1" as="geometry"/></mxCell>
        </object>
        <mxCell id="rel-resident-app" value="Finds a dock, unlocks a bike and sees receipts" style="endArrow=blockThin;html=1;fontSize=10;strokeColor=#828282;endFill=1;" edge="1" parent="1" source="resident" target="app"><mxGeometry width="240" relative="1" as="geometry"/></mxCell>
        <mxCell id="trip-record" value="Trip record" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#99ffff;shape=mxgraph.archimate3.application;appType=passive;archiType=square;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="150" height="75" as="geometry"/></mxCell>
        <mxCell id="note" value="Illustrative; no real product is named." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="300" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
