    "Process customer orders reliably",
    "Protect payment processing from dependency failures",
    "Support measurable availability and latency objectives"
  ],
  "constraints": [
    "Cloud agnostic logical design",
    "No direct storage of payment card data"
  ],
  "assumptions": [
    "Initial team size is eight engineers",
    "Peak volume is 250 orders per second"
  ],
