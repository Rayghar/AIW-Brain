    "/api/admin/mind-factory/claims/normalize",
    "/api/admin/mind-factory/release-impact-preview",
    "/api/admin/mind-factory/stage-traceability",
    "/api/admin/mind-factory/knowledge-pack/export",
    "/api/admin/mind-factory/knowledge-pack/import"
  ],
  "stageTraceability": ["brief", "quality-drivers", "patterns-and-tactics", "canvas-modelling", "review-studio", "repository-conformance", "architecture-handoff"]
