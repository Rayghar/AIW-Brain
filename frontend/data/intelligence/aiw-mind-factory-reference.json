{
  "version": "0.10.0-rc.10.21",
  "pipeline": [
    "register-source",
    "capture-pinned-snapshot",
    "quarantine",
    "extract-candidate-claims",
    "normalize-duplicates-synonyms",
    "detect-contradictions",
    "calculate-corroboration",
