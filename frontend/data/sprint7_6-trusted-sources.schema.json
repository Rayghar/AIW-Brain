{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiw.local/schemas/trusted-architecture-sources-v0.8.6.json",
  "title": "AIW Trusted Architecture Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryId", "version", "sources"],
  "properties": {
    "registryId": { "const": "AIW-TRUSTED-SOURCES" },
    "version": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "publisher", "sourceType", "authorityLevel", "url", "scopeTags", "status", "reviewedAt", "refreshCadenceDays", "ingestionMode"],
        "properties": {
          "id": { "type": "string", "pattern": "^SRC-" },
          "title": { "type": "string", "minLength": 3 },
          "publisher": { "type": "string", "minLength": 2 },
          "sourceType": { "enum": ["standard", "open-standard", "specification", "official-method", "research-method", "vendor-guidance", "internal-standard"] },
          "authorityLevel": { "type": "integer", "minimum": 1, "maximum": 5 },
          "url": { "type": "string", "minLength": 5 },
          "scopeTags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "status": { "enum": ["approved", "candidate", "deprecated"] },
          "reviewedAt": { "type": "string", "format": "date" },
          "refreshCadenceDays": { "type": "integer", "minimum": 1 },
          "ingestionMode": { "enum": ["manual-reviewed", "allowlisted-refresh"] }
        }
      }
    }
  }
}
