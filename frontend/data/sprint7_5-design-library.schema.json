{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiw.local/schemas/design-library-v0.8.5.json",
  "title": "AIW Visual Design Library",
  "type": "object",
  "required": ["libraryId", "version", "records"],
  "properties": {
    "libraryId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
      "additionalProperties": false
    },
    "port": {
      "type": "object",
      "required": ["id", "label", "direction", "relationshipKinds", "semanticTypes", "position"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "direction": { "enum": ["input", "output", "bidirectional"] },
        "relationshipKinds": { "type": "array", "items": { "type": "string" } },
        "semanticTypes": { "type": "array", "items": { "type": "string" } },
        "position": { "enum": ["left", "right", "top", "bottom"] }
      },
      "additionalProperties": false
    },
    "depiction": {
      "type": "object",
      "required": ["renderer", "icon", "shape", "defaultSize", "canContainChildren", "ports", "previewKind", "notationMappings"],
      "properties": {
        "renderer": { "type": "string" },
        "icon": { "type": "string" },
        "shape": { "enum": ["card", "boundary", "cylinder", "event", "actor", "infrastructure", "control"] },
        "defaultSize": { "type": "object", "required": ["width", "height"], "properties": { "width": { "type": "number" }, "height": { "type": "number" } }, "additionalProperties": false },
        "canContainChildren": { "type": "boolean" },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "previewKind": { "type": "string" },
        "notationMappings": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "property": {
      "type": "object",
      "required": ["key", "label", "type", "description"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "type": { "enum": ["text", "number", "boolean", "enum", "multiline"] },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "defaultValue": {},
        "options": { "type": "array", "items": { "type": "object", "required": ["label", "value"], "properties": { "label": { "type": "string" }, "value": {} }, "additionalProperties": false } },
        "min": { "type": "number" },
        "max": { "type": "number" }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": ["id", "recordType", "name", "category", "description", "applicableStages", "maturity", "approvalStatus", "version", "tags", "depiction", "properties", "qualityAttributeImpact", "whenToUse", "whenToQuestion", "requires", "recommends", "pairsWellWith", "conflictsWith", "obligations", "risks", "mitigations", "evidenceIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "recordType": { "enum": ["component", "pattern", "style", "template"] },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "applicableStages": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "applicableViewpoints": { "type": "array", "items": { "type": "string" } },
        "maturity": { "enum": ["emerging", "established", "mature"] },
        "approvalStatus": { "enum": ["draft", "approved", "deprecated"] },
        "owner": { "type": "string" },
        "version": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "depiction": { "$ref": "#/$defs/depiction" },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } },
        "qualityAttributeImpact": { "type": "object", "additionalProperties": { "type": "number" } },
        "whenToUse": { "type": "array", "items": { "type": "string" } },
        "whenToQuestion": { "type": "array", "items": { "type": "string" } },
        "requires": { "type": "array", "items": { "type": "string" } },
        "recommends": { "type": "array", "items": { "type": "string" } },
        "pairsWellWith": { "type": "array", "items": { "type": "string" } },
        "conflictsWith": { "type": "array", "items": { "type": "string" } },
        "obligations": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "mitigations": { "type": "array", "items": { "type": "string" } },
        "evidenceIds": { "type": "array", "items": { "type": "string" } },
        "componentKind": { "type": "string" },
        "defaultProperties": { "type": "object" },
        "nodeTemplate": { "type": "array" },
        "edgeTemplate": { "type": "array" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
